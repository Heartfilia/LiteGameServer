# Relative paths resolve from this project, not the shell's current directory.
LITEGAME_DB=data/litegame.sqlite3
LITEGAME_HOST=127.0.0.1
LITEGAME_PORT=9494
# Comma-separated exact browser origins, without trailing slashes. Never use *.
LITEGAME_CORS_ORIGINS=https://game.litetools.top,http://127.0.0.1:8766,http://localhost:8766
LITEGAME_SESSION_DAYS=30
LITEGAME_MAX_BODY_BYTES=16777216
LITEGAME_MAX_RECORD_BYTES=1048576
LITEGAME_MAX_NES_BYTES=12582912
LITEGAME_USER_QUOTA_BYTES=67108864
# Includes deletion tombstones. Retained to support offline devices.
LITEGAME_MAX_RECORDS=5000
LITEGAME_LOGIN_LIMIT=10
LITEGAME_LOGIN_WINDOW_SECONDS=900
